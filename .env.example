# ElevenLabs API Key (required for premium voices)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Stripe keys for billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site URL (set per environment in Vercel: Production vs Preview)
NEXT_PUBLIC_BASE_URL=https://varterm.com

# MCP / scripts default API base (see mcp-server.js). Often same as NEXT_PUBLIC_BASE_URL.
# VARTERM_URL=https://varterm.com

# Optional: smoke script (scripts/smoke.mjs) — overrides NEXT_PUBLIC_BASE_URL / VARTERM_URL
# VARTERM_SMOKE_URL=https://varterm.com

# Optional: same value as Vercel "VARTERM_EXTENSION_API_TOKEN" if ingest API is protected
# VARTERM_EXTENSION_API_TOKEN=

# On Vercel, VERCEL_URL is set automatically; smoke script builds https://VERCEL_URL when useful.
# For CI against a preview, pass: VARTERM_SMOKE_URL=https://your-deployment.vercel.app npm run smoke

# Optional: user accounts + saved recordings (see docs/accounts-and-streaming.md)
# VARTERM_ACCOUNTS_ENABLED=true
# VARTERM_AUTH_SECRET=use-a-random-string-at-least-32-characters-long
# VARTERM_ACCOUNT_DIR=/tmp/varterm-accounts
# VARTERM_MAX_RECORDING_BYTES=26214400
# VARTERM_MAX_RECORDINGS_PER_USER=50
