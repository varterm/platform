{
  "name": "varterm-tts",
  "displayName": "Varterm TTS - Text to Speech",
  "description": "Read code, documentation, and errors aloud with natural AI voices. Works offline and online.",
  "version": "1.0.0",
  "publisher": "varterm",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/varterm/varterm"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Accessibility"
  ],
  "keywords": [
    "text to speech",
    "tts",
    "accessibility",
    "read aloud",
    "voice",
    "audio",
    "cursor",
    "ai voices"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "varterm.readSelection",
        "title": "Varterm: Read Selection Aloud"
      },
      {
        "command": "varterm.readLine",
        "title": "Varterm: Read Current Line"
      },
      {
        "command": "varterm.readDocument",
        "title": "Varterm: Read Entire Document"
      },
      {
        "command": "varterm.readErrors",
        "title": "Varterm: Read Errors & Warnings"
      },
      {
        "command": "varterm.stop",
        "title": "Varterm: Stop Speaking"
      },
      {
        "command": "varterm.pause",
        "title": "Varterm: Pause/Resume"
      }
    ],
    "keybindings": [
      {
        "command": "varterm.readSelection",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "varterm.readLine",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "varterm.readErrors",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      },
      {
        "command": "varterm.stop",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      }
    ],
    "configuration": {
      "title": "Varterm TTS",
      "properties": {
        "varterm.voiceTier": {
          "type": "string",
          "default": "cloud",
          "enum": ["cloud", "browser", "offline"],
          "enumDescriptions": [
            "Microsoft neural voices (best quality, requires internet)",
            "Browser built-in voices (fast, basic quality)",
            "Piper AI voices (runs locally, no internet needed)"
          ],
          "description": "Voice tier to use for text-to-speech"
        },
        "varterm.voice": {
          "type": "string",
          "default": "en-US-AriaNeural",
          "description": "Voice ID to use (depends on selected tier)"
        },
        "varterm.rate": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.5,
          "maximum": 2.0,
          "description": "Speech rate (0.5 to 2.0)"
        },
        "varterm.apiEndpoint": {
          "type": "string",
          "default": "https://varterm.com",
          "description": "Varterm API endpoint (change for self-hosted)"
        },
        "varterm.stripMarkdown": {
          "type": "boolean",
          "default": true,
          "description": "Strip markdown formatting before speaking"
        },
        "varterm.autoReadErrors": {
          "type": "boolean",
          "default": false,
          "description": "Automatically read new errors when they appear"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "varterm.readSelection",
          "when": "editorHasSelection",
          "group": "varterm"
        },
        {
          "command": "varterm.readLine",
          "when": "!editorHasSelection",
          "group": "varterm"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^2.22.0"
  }
}
